.after-sale-root {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.hero {
  background: linear-gradient(145deg, #0f172a 0%, #1e293b 55%, #334155 100%);
  color: #f8fafc;
  padding: 36rpx 32rpx 48rpx;
}

.hero-kicker {
  display: block;
  font-size: 22rpx;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  opacity: 0.75;
  margin-bottom: 12rpx;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.hero-sub {
  display: block;
  font-size: 24rpx;
  line-height: 1.55;
  opacity: 0.88;
}

.card {
  background: #fff;
  margin: -28rpx 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.08);
}

.order-strip {
  margin-top: -36rpx;
}

.order-strip-main {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  align-items: center;
}

.thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: #e2e8f0;
}

.thumb.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #64748b;
}

.order-strip-info {
  flex: 1;
}

.p-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #0f172a;
}

.p-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.order-strip-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

.link-btn {
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #334155;
  border: 1rpx solid #cbd5e1;
  border-radius: 999rpx;
}

.primary-btn {
  padding: 16rpx 28rpx;
  font-size: 24rpx;
  color: #fff;
  background: #2563eb;
  border-radius: 999rpx;
}

.address-card.muted {
  opacity: 0.95;
}

.address-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.address-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.copy-mini {
  font-size: 24rpx;
  color: #2563eb;
}

.address-body {
  display: block;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.55;
  white-space: pre-wrap;
}

.address-empty {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.section-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  padding: 8rpx 32rpx 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.section-count {
  font-size: 24rpx;
  color: #64748b;
}

.refund-stack {
  padding: 0 24rpx;
}

.refund-row {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.06);
}

.refund-row-focus {
  border-color: #93c5fd;
  background: #eff6ff;
}

.refund-row-top {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.rtype {
  font-size: 26rpx;
  font-weight: 500;
  color: #0f172a;
}

.rstat {
  font-size: 24rpx;
}

.status-pending { color: #d97706; }
.status-approved { color: #16a34a; }
.status-processing { color: #2563eb; }
.status-completed { color: #64748b; }
.status-rejected { color: #dc2626; }
.status-cancelled { color: #94a3b8; }

.rno {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.ramount {
  display: block;
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
}

.rcta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #2563eb;
}

.empty-refunds {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
  background: #fff;
  border-radius: 18rpx;
}

.loading-wrap {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  color: #64748b;
  font-size: 26rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
