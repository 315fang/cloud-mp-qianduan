.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f5f8fc;
}

.hero {
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #12366a 0%, #0e62b8 100%);
  color: #fff;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
}

.hero-sub {
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.78);
}

.section {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(21, 80, 156, 0.07);
}

.section-head {
  margin-bottom: 22rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #17396d;
}

.section-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8ea1be;
}

.form-row {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid #edf2f8;
}

.form-label {
  font-size: 25rpx;
  color: #42526e;
}

.form-input {
  width: 220rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #f6f9ff;
  text-align: right;
  color: #12366a;
  font-size: 26rpx;
  box-sizing: border-box;
}

.estimate-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.estimate-item {
  min-height: 120rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f6f9ff;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  justify-content: center;
}

.estimate-item.total {
  background: #eef7f1;
}

.estimate-label {
  font-size: 21rpx;
  color: #7184a3;
}

.estimate-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #0e62b8;
}

.rule-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf2f8;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.rule-item:last-child {
  border-bottom: none;
}

.rule-title,
.role-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f3557;
}

.rule-desc,
.role-desc {
  font-size: 23rpx;
  line-height: 1.55;
  color: #6f87aa;
}

.role-item {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 0;
}

.role-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #0e62b8;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.role-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.footer-note {
  padding: 24rpx 8rpx 0;
  font-size: 22rpx;
  line-height: 1.6;
  color: #8ea1be;
  text-align: center;
}
