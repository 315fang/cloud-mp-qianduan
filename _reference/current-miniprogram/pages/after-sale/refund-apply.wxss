/* pages/after-sale/refund-apply.wxss */
.container {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0F172A;
  margin: 24rpx 0 16rpx;
}

.section-title-inline {
  margin-top: 0;
}

.type-group {
  display: flex;
  gap: 20rpx;
}

.type-item {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E2E8F0;
  transition: all 0.2s;
}

.type-item.active {
  border-color: #0F172A;
  background: #F8FAFC;
}

.type-info {
  margin-left: 16rpx;
}

.type-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #0F172A;
  display: block;
}

.type-desc {
  font-size: 22rpx;
  color: #94A3B8;
  display: block;
  margin-top: 4rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 0;
}

.order-product {
  display: flex;
  align-items: center;
}

.order-summary {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.bundle-refund-tip {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(185, 139, 88, 0.08);
  color: #8d6a3f;
  font-size: 24rpx;
  line-height: 1.6;
}

.refund-item-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.refund-item-card {
  border: 1rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 20rpx;
  background: #F8FAFC;
}

.refund-item-head {
  display: flex;
  align-items: center;
}

.product-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #F1F5F9;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
}

.product-name {
  font-size: 28rpx;
  color: #0F172A;
  display: block;
  margin-bottom: 8rpx;
}

.product-price {
  font-size: 26rpx;
  color: #64748B;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #0F172A;
}

.picker-row .placeholder {
  color: #94A3B8;
}

.picker-row .arrow {
  color: #CBD5E1;
  font-size: 32rpx;
}

.desc-input {
  width: 100%;
  min-height: 160rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #0F172A;
  box-sizing: border-box;
}

.evidence-panel {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.evidence-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.evidence-item,
.evidence-add {
  width: 156rpx;
  height: 156rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.evidence-item {
  position: relative;
  background: #F1F5F9;
}

.evidence-img {
  width: 156rpx;
  height: 156rpx;
}

.evidence-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.72);
  color: #fff;
  font-size: 28rpx;
}

.evidence-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx dashed #CBD5E1;
  color: #94A3B8;
  background: #F8FAFC;
}

.evidence-add-icon {
  font-size: 46rpx;
  line-height: 1;
}

.evidence-add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.evidence-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #94A3B8;
}

.amount-row {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
}

.amount-symbol {
  font-size: 36rpx;
  font-weight: 600;
  color: #0F172A;
  margin-right: 8rpx;
}

.amount-value {
  flex: 1;
  font-size: 32rpx;
  color: #0F172A;
  font-weight: 600;
}

.amount-max {
  font-size: 22rpx;
  color: #94A3B8;
  flex-shrink: 0;
  max-width: 220rpx;
  text-align: right;
}

.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
}

.submit-btn {
  background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%) !important;
  color: #fff !important;
  border-radius: 48rpx !important;
  font-size: 30rpx !important;
  padding: 24rpx 0 !important;
  border: none !important;
}

.submit-btn.disabled {
  opacity: 0.5;
}

/* 退货数量 */
.qty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
}

.qty-control {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.refund-item-qty {
  margin-top: 16rpx;
  padding: 0;
  background: transparent;
}

.bundle-refund-item-lock {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #fff;
  display: flex;
  justify-content: flex-end;
}

.qty-btn {
  width: 64rpx;
  height: 64rpx;
  background: #F1F5F9;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #0F172A;
}

.qty-btn-disabled {
  opacity: 0.45;
}

.qty-input {
  width: 100rpx;
  height: 64rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #0F172A;
  background: #F8FAFC;
  border-radius: 12rpx;
}

.qty-hint {
  font-size: 24rpx;
  color: #94A3B8;
}

.refund-qty-tip {
  font-size: 22rpx;
  color: #F97316;
  padding: 12rpx 0 0;
}

.refund-only-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFF7ED;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #92400E;
}

.tip-icon-img {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.tip-icon {
  font-size: 28rpx;
}

.return-address-panel {
  margin-top: 8rpx;
}

.return-address-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0 12rpx;
}

.return-address-heading {
  margin: 0;
}

.copy-mini {
  font-size: 26rpx;
  color: #4F46E5;
  padding: 8rpx 12rpx;
}

.return-address-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #E2E8F0;
}

.return-address-body {
  font-size: 26rpx;
  color: #0F172A;
  white-space: pre-wrap;
  line-height: 1.5;
}

.return-address-empty {
  background: #F8FAFC;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.5;
}

.return-address-hint {
  display: block;
  font-size: 22rpx;
  color: #94A3B8;
  margin-top: 12rpx;
  line-height: 1.45;
}

/* 自行邮寄退货流程（参考主流电商平台心智） */
.return-self-ship-flow {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 16rpx 0 8rpx;
  border: 2rpx solid #E2E8F0;
}

.return-flow-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.return-flow-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
}

.return-flow-badge {
  font-size: 22rpx;
  color: #C2410C;
  background: #FFF7ED;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.return-flow-banner {
  padding: 20rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #EFF6FF 0%, #F8FAFC 100%);
  border: 1rpx solid #BFDBFE;
  margin-bottom: 20rpx;
}

.return-flow-banner-main {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1E3A8A;
  line-height: 1.45;
  margin-bottom: 8rpx;
}

.return-flow-banner-sub {
  display: block;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.55;
}

.return-flow-steps {
  padding-left: 8rpx;
}

.return-flow-step {
  display: flex;
  align-items: flex-start;
  padding-bottom: 22rpx;
  position: relative;
}

.return-flow-step:not(.return-flow-step-last)::before {
  content: '';
  position: absolute;
  left: 22rpx;
  top: 44rpx;
  bottom: 0;
  width: 2rpx;
  background: #E2E8F0;
}

.step-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #0F172A;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  position: relative;
  z-index: 1;
}

.step-body {
  flex: 1;
  padding-top: 2rpx;
}

.step-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0F172A;
  margin-bottom: 4rpx;
}

.step-desc {
  display: block;
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.45;
}

.return-flow-step-last {
  padding-bottom: 0;
}

.return-flow-tips {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #E2E8F0;
}

.tip-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #92400E;
  margin-bottom: 12rpx;
}

.tip-line {
  display: block;
  font-size: 22rpx;
  color: #78350F;
  line-height: 1.55;
  margin-bottom: 8rpx;
}
